*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.lof
*.lot
*.idx
*.ind
*.ilg
*.bbl
*.bcf
*.blg
*.run.xml
*.synctex.gz
*.synctex(busy)
*.pdfsync

# LaTeX temporary files
*.nav
*.snm
*.vrb
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.ist
*.loa
*.thm
*.figlist
*.makefile
*.listing

# LaTeX build directories
build/
dist/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
.vscode/
*.swp
*.swo
*~

# Backup files
*.backup
*.bak
*.orig

